{
  "name": "{{project}}",
  "framework": "laravel",
  "language": "php",
  "version": "{{version}}",
  "installer": {
    "type": "docker",
    "command": [
      "docker", "run", "--rm",
      "-v", "{{projectPath}}:/workspace",
      "-w", "/workspace",
      "composer:latest",
      "create-project", "--prefer-dist", "--no-interaction",
      "laravel/laravel", "src"
    ]
  },
  "services": {
    "app": {
      "type": "build",
      "dockerfile": "infra/docker/Dockerfile",
      "working_dir": "/var/www",
      "volumes": [
        "./src:/var/www",
        "./infra/docker/local.ini:/usr/local/etc/php/conf.d/local.ini"
      ],
      "depends_on": ["mysql", "redis"],
      "restart": "unless-stopped"
    },
    "webserver": {
      "type": "image",
      "image": "nginx:alpine",
      "ports": ["8000:80"],
      "volumes": [
        "./src:/var/www",
        "./infra/docker/nginx.conf:/etc/nginx/conf.d/default.conf"
      ],
      "depends_on": ["app"],
      "restart": "unless-stopped"
    },
    "mysql": {
      "type": "image",
      "image": "mysql:8.0",
      "ports": ["3306:3306"],
      "environment": {
        "MYSQL_DATABASE": "laravel",
        "MYSQL_ROOT_PASSWORD": "root",
        "MYSQL_PASSWORD": "laravel",
        "MYSQL_USER": "laravel"
      },
      "volumes": ["mysql_data:/var/lib/mysql"],
      "restart": "unless-stopped"
    },
    "redis": {
      "type": "image",
      "image": "redis:alpine",
      "ports": ["6379:6379"],
      "restart": "unless-stopped"
    },
    "mailhog": {
      "type": "image",
      "image": "mailhog/mailhog",
      "ports": ["1025:1025", "8025:8025"],
      "restart": "unless-stopped"
    }
  },
  "volumes": {
    "mysql_data": { "driver": "local" }
  },
  "networks": {
    "default": { "driver": "bridge" }
  }
}
