{
  "$schema": "../gen/schemas/capabilities.json",
  "identifier": "default",
  "description": "Default capabilities for Atempo desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/atempo",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "dialog:default",
    "opener:default",
    "fs:default"
  ]
}
