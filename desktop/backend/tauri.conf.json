{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atempo",
  "version": "0.1.0",
  "identifier": "au.rswm.atempo",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../frontend" },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../frontend" },
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Atempo",
        "width": 1024,
        "height": 700,
        "minWidth": 760,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/atempo"]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
